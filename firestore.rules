rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogueado() {
      return request.auth != null;
    }

    function rolDe(uid) {
      return get(/databases/$(database)/documents/usuarios/$(uid)).data.rol;
    }

    function miRol() {
      return rolDe(request.auth.uid);
    }

    match /usuarios/{uid} {
      allow read: if estaLogueado() && (request.auth.uid == uid || miRol() == 'gerencia');
      allow list: if estaLogueado() && miRol() in ['secretaria', 'gerencia'];
      allow write: if estaLogueado() && miRol() == 'gerencia';
    }

    match /pacientes/{dni} {
      allow read: if estaLogueado() && miRol() in ['secretaria', 'gerencia', 'profesional'];
      allow write: if estaLogueado() && miRol() == 'secretaria';
    }

    // Las queries con collectionGroup(db, 'visitas') sólo respetan reglas
    // declaradas con el wildcard recursivo {path=**}: una regla anidada bajo
    // /pacientes/{dni}/visitas/{visitaId} NO se aplica a collectionGroup(),
    // sólo a lecturas directas de la subcolección. Por eso va acá afuera.
    //
    // La lectura se habilita para los 3 roles sin restricción por
    // profesionalUid: la vista de Historia Clínica requiere que cualquier
    // miembro autorizado del personal (secretaria, profesional o gerencia)
    // pueda ver el historial completo de un paciente, incluidas las visitas
    // atendidas por otros profesionales. Escribir (create/update/delete)
    // sigue restringido como antes.
    match /{path=**}/visitas/{visitaId} {
      allow read: if estaLogueado() && miRol() in ['secretaria', 'gerencia', 'profesional'];
      allow create: if estaLogueado() && miRol() == 'secretaria';
      allow update: if estaLogueado() && miRol() == 'profesional'
        && resource.data.profesionalUid == request.auth.uid
        && request.resource.data.profesionalUid == resource.data.profesionalUid;
      allow delete: if estaLogueado() && miRol() == 'secretaria';
    }

    match /instituciones/{institucionId} {
      allow read: if estaLogueado() && miRol() in ['captacion', 'gerencia'];
      allow create, update: if estaLogueado() && miRol() == 'captacion';
    }

    // Mismo motivo que con 'visitas': para que Gerencia pueda leer los
    // contactos de todas las instituciones con collectionGroup(db, 'contactos')
    // esta regla tiene que declararse acá afuera con el wildcard recursivo.
    //
    // Los contactos son de solo lectura una vez creados (no hay allow update
    // ni allow delete): si hay que corregir un error se carga un contacto
    // nuevo aclarándolo, nunca se edita o borra el anterior.
    match /{path=**}/contactos/{contactoId} {
      allow read: if estaLogueado() && miRol() in ['captacion', 'gerencia'];
      allow create: if estaLogueado() && miRol() == 'captacion';
    }
  }
}